# Copy to .env and adjust for running `go run ./cmd/server` directly on the
# host against services started via `docker compose up mysql mock-pbx-worker mock-laravel`.
# When running everything through `docker compose up`, these are set in
# docker-compose.yml instead and this file is not read.

APP_ENV=local
HTTP_PORT=8080

INCOMING_AUTH_DISABLED=true
INCOMING_HMAC_API_KEY=local-dev-key
INCOMING_HMAC_SECRET=local-dev-secret
INCOMING_HMAC_TOLERANCE_SECONDS=300

QSTATS_DSN=qstats:qstatspass@tcp(localhost:3307)/qstats?parseTime=true

PBX_WORKER_MODE=hmac
PBX_WORKER_BASE_URL=http://localhost:8081
PBX_WORKER_API_KEY=local-dev-key
PBX_WORKER_SECRET=local-dev-secret
# PBX_WORKER_JWT_TOKEN=   # only used when PBX_WORKER_MODE=jwt (v3, not implemented yet)

LARAVEL_CALLBACK_BASE_URL=http://localhost:8082
LARAVEL_CALLBACK_PATH=/api/internal/call-center/callback-attempts
LARAVEL_CALLBACK_API_KEY=local-dev-key
LARAVEL_CALLBACK_SECRET=local-dev-secret
